CARDS_FOLDERS=
MEILI_MASTER_KEY=
# Override when running inside Docker (default is http://localhost:7700 for local scripts)
MEILI_URL=http://meilisearch:7700
# Number of items per page (default: 20)
# PAGE_SIZE=20
ALLOW_ORIGIN_REGEX=http://localhost(:\d+)?
# Public-facing URL used to build absolute image URLs in OG tags
PUBLIC_URL=https://yourdomain.com
